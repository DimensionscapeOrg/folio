package folio.ll;

/**
	The List & Label numbers a caller passes and receives. The values are List & Label's,
	so a program written against it gets the answers it expects.
**/
class Constants {
	public static inline final LL_OPTION_LASTPAGE = 6;
	public static inline final LL_OPTION_DEFPRINTERINSTALLED = 57;
	public static inline final LL_PRNOPTSTR_PRINTJOBNAME = 3;

	public static inline final LL_ERR_BAD_JOBHANDLE = -1;
	public static inline final LL_ERR_CFGNOTFOUND = -22;
	public static inline final LL_WRN_TABLECHANGE = -996;
	public static inline final LL_WRN_REPEAT_DATA = -998;
}
